{
  // Phase 5, Block 1 (12.07.2026): vollständige Cloudflare-Workers/OpenNext-
  // Deployment-Konfiguration — vorher war dies bewusst nur ein Schablonen-
  // Eintrag für den Cron Trigger (Historie siehe PHASENSTATUS.md, Phase 5).
  //
  // `main` zeigt NICHT direkt auf den von @opennextjs/cloudflare generierten
  // Worker (`.open-next/worker.js`, exportiert nur einen fetch-Handler),
  // sondern auf `custom-worker.ts` — dieser reicht den generierten
  // fetch-Handler unverändert durch und ergänzt den scheduled-Handler für
  // den Cron Trigger unten (offizielles OpenNext-Muster, siehe Kommentar in
  // custom-worker.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calltalent-akademie",
  // Explizit gesetzt (12.07.2026, Block 8): office@calltalent.ai ist Mitglied
  // in zwei Cloudflare-Accounts; ohne diese Angabe wählt wrangler beim Login
  // den falschen (nicht den, der calltalent.ai/die Custom-Domain besitzt).
  // Account "calltalent.ai" — sichtbar im Dashboard oben links.
  "account_id": "1721e487e86d9139ee900f52e2882622",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Nachtrag (14.07.2026, Josips Deploy-Versuch): Routen + Variablen waren
  // bisher NUR im Cloudflare-Dashboard gesetzt, nicht hier. `wrangler deploy`
  // überschreibt bei jedem Lauf die Remote-Konfiguration komplett mit dieser
  // Datei — ohne die beiden Einträge unten hätte der nächste erfolgreiche
  // Deploy sowohl die Domain-Routen als auch ALLE API-Keys (Anthropic,
  // Supabase Service-Role, Resend, Bunny Stream, Voyage) gelöscht und die
  // Seite lahmgelegt. `routes` hier eingetragen (unbedenklich, keine
  // Geheimnisse). `keep_vars: true` sorgt zusätzlich dafür, dass die im
  // Dashboard gesetzten Variablen/Secrets von künftigen Deploys NIE mehr
  // angerührt werden — Secrets gehören ohnehin nicht in eine Git-versionierte
  // Datei, siehe PHASENSTATUS.md.
  "routes": [
    { "pattern": "*.calltalent.ai/*", "zone_name": "calltalent.ai" },
    { "pattern": "academy.calltalent.ai/*", "zone_name": "calltalent.ai" }
  ],
  "keep_vars": true,
  "triggers": {
    // Alle 2 Minuten - ein ai_jobs-Schritt braucht typischerweise wenige
    // Sekunden bis niedrige zweistellige Sekunden (ein Claude-Sonnet-Aufruf),
    // ein Kursentwurf (3 Schritte) ist damit binnen weniger Minuten fertig.
    "crons": ["*/2 * * * *"]
  }
}
