# Calltalent-Akademie — Vorlage. Kopieren nach .env und Werte eintragen.
NEXT_PUBLIC_SUPABASE_URL=https://vklqksdiyiijzoirntyt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Betreiber-Portal-Host (Phase 4, Block 1). Optional — Default portal.localhost.
NEXT_PUBLIC_PORTAL_HOST=portal.localhost
# Marketplace-Host (Marketplace M4). Optional — Default marketplace.localhost.
NEXT_PUBLIC_MARKETPLACE_HOST=marketplace.localhost
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_READONLY_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
CRON_PROCESS_SECRET=
# Web-Push VAPID-Schluesselpaar (Phase 4, Block 5) — selbst generierbar, z. B.
# via `npx web-push generate-vapid-keys` oder Node crypto (EC P-256), kein
# externer Anbieter/Signup noetig.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@calltalent.ai
# Cloudflare Turnstile (Bot-Schutz Kontaktformular, 25.08.2026). Beide Werte
# aus dem Cloudflare-Dashboard: Turnstile -> Add Widget (Modus "Managed",
# Domains: academy.calltalent.ai, salestalent.app, localhost). Optional —
# solange leer, ist Turnstile abgeschaltet und die uebrigen fuenf
# Schutzschichten greifen unveraendert. Der Secret Key gehoert NUR in die
# Worker-Secrets, nie in eine getrackte Datei.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Phase 4, Block 6 (Playwright-E2E-Suite) — Passwort für die beiden
# synthetischen Test-Accounts e2e-staff@example.test/e2e-student@example.test
# (example.test ist laut RFC 2606 eine reservierte Testdomain). Optional —
# e2e/global-setup.ts hat einen Standard-Testwert, falls nicht gesetzt. KEIN
# Produktionssecret.
E2E_TEST_PASSWORD=
